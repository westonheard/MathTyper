{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MathTyper",
  "version": "0.1.1",
  "identifier": "com.westonheard.mathtyper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "MathTyper",
        "width": 1240,
        "height": 820
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mtd"
        ],
        "name": "MathTyper Document",
        "description": "MathTyper document",
        "role": "Editor",
        "mimeType": "application/x-mathtyper"
      }
    ]
  }
}
